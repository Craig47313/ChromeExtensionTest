{
  "manifest_version": 3,
  "name": "Timecheck",
  "short_name": "Timecheck",
  "version": "0.6.0",
  "description": "Plan your school day, run focus blocks and gate distracting sites. Block days, a weekly review, and Onitry screen monitoring built in.",
  "minimum_chrome_version": "116",
  "key": "",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Timecheck",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "side_panel": {
    "default_path": "today.html?view=panel"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage",
    "unlimitedStorage",
    "sidePanel",
    "alarms",
    "notifications",
    "declarativeNetRequest",
    "idle",
    "nativeMessaging",
    "offscreen"
  ],
  "optional_permissions": [
    "tabs"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "*://*.youtube.com/*",
    "*://*.reddit.com/*",
    "*://*.instagram.com/*",
    "*://*.tiktok.com/*",
    "*://*.x.com/*",
    "*://*.twitter.com/*",
    "*://*.netflix.com/*",
    "*://*.twitch.tv/*",
    "*://*.facebook.com/*"
  ],
  "optional_host_permissions": [
    "*://*/*"
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+P"
      },
      "description": "Open Timecheck"
    }
  },
  "externally_connectable": {
    "ids": ["*"]
  },
  "web_accessible_resources": [
    {
      "resources": [
        "guard.html"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
