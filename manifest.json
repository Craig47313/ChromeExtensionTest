{
  "manifest_version": 3,
  "name": "Inkwell — Notes & Drawing",
  "short_name": "Inkwell",
  "version": "1.4.0",
  "description": "Plan your day, focus, and take notes and sketches in Chrome. A Today planner with focus blocks, a distraction gate and Onitry integration, plus rich notes, drawings and a graphing calculator.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Open Inkwell",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "side_panel": {
    "default_path": "app.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage",
    "unlimitedStorage",
    "sidePanel",
    "contextMenus",
    "activeTab",
    "scripting",
    "alarms",
    "notifications",
    "declarativeNetRequest",
    "idle"
  ],
  "optional_permissions": [
    "tabs"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "*://*.youtube.com/*",
    "*://*.reddit.com/*",
    "*://*.instagram.com/*",
    "*://*.tiktok.com/*",
    "*://*.x.com/*",
    "*://*.twitter.com/*",
    "*://*.netflix.com/*",
    "*://*.twitch.tv/*",
    "*://*.facebook.com/*"
  ],
  "optional_host_permissions": [
    "<all_urls>"
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+N"
      },
      "description": "Open Inkwell"
    },
    "annotate-page": {
      "suggested_key": {
        "default": "Alt+Shift+D"
      },
      "description": "Draw on the current page"
    }
  },
  "chrome_url_overrides": {
    "newtab": "today.html"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "guard.html"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
