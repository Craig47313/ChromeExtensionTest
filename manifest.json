{
  "manifest_version": 3,
  "name": "Inkwell — Notes & Drawing",
  "short_name": "Inkwell",
  "version": "1.3.0",
  "description": "Rich notes, sketches and page annotations in Chrome's side panel. Clip text from any site and draw right on top of web pages.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Open Inkwell",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "side_panel": {
    "default_path": "app.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage",
    "unlimitedStorage",
    "sidePanel",
    "contextMenus",
    "activeTab",
    "scripting"
  ],
  "optional_permissions": [
    "tabs"
  ],
  "optional_host_permissions": [
    "<all_urls>"
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+N"
      },
      "description": "Open Inkwell"
    },
    "annotate-page": {
      "suggested_key": {
        "default": "Alt+Shift+D"
      },
      "description": "Draw on the current page"
    }
  }
}
